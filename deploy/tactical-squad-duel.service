[Unit]
Description=Campus Arcana - authoritative Godot game server
After=network.target

[Service]
Type=simple
User=tsd
WorkingDirectory=/opt/tactical-squad-duel
# Godot Linux binary (e.g. Godot_v4.7.2-stable_linux.x86_64) copied to /usr/local/bin/godot
ExecStart=/usr/local/bin/godot --headless --path /opt/tactical-squad-duel -- --server --port=9080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
